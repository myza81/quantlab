# QuantLab Environment Configuration
# Copy to .env and fill in values. Never commit .env.

# Application
APP_NAME=QuantLab
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# PostgreSQL (metadata store — future)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/quantlab

# Redis (queue / cache — future)
# REDIS_URL=redis://localhost:6379/0
